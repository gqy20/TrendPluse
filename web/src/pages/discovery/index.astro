---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { routes } from '../../lib/path';
import StatRow from '../../components/ui/StatRow.astro';
import SnapshotBars from '../../components/data/SnapshotBars.astro';
import { formatNumber } from '../../lib/format';

const discovery = (await getCollection('discovery')).sort((a, b) => b.id.localeCompare(a.id));
const discDate = (id: string) => id.replace(/^discovery-/, '');
const totalCandidates = discovery.reduce((sum, e) => sum + (e.data.passed_quality ?? e.data.candidates.length), 0);

const latest = discovery[0]?.data;
// 最近七期通过质量评估的数量，未做跨期去重。
const weeklyNew = discovery.slice(0, 7).reduce((sum, e) => sum + (e.data.passed_quality ?? e.data.candidates.length), 0);
const highRatio = latest && latest.candidates.length > 0 && latest.high_priority != null
  ? Math.round(latest.high_priority / latest.candidates.length * 100)
  : null;

// 本周值得关注:最新一期,推荐优先 → 7 日增长
const featured = latest
  ? [...latest.candidates]
      .sort((a, b) => (Number(b.recommended) - Number(a.recommended)) || (b.stars_growth_7d ?? 0) - (a.stars_growth_7d ?? 0))
      .slice(0, 3)
  : [];
---

<BaseLayout title="项目发现" description="从 GitHub Trending 发现值得监控的新项目">
  <div class="tp-shell tp-grid pt-12 pb-8">
    <div class="min-w-0">
      <!-- Hero -->
      <header class="hero-data pb-12">
        <div>
          <h1 class="tp-h1">项目发现</h1>
          <p class="tp-body text-ink-2 mt-5 max-w-[560px]">
            每天从 GitHub Trending 里筛掉噪声,只留下值得监控的新项目。先看证据,再决定是否扩大监控范围。
          </p>
          <div class="mt-8">
            <StatRow
              stats={[
                { value: discovery.length, label: '发现期数' },
                { value: formatNumber(totalCandidates), label: '累计通过次数' },
                { value: formatNumber(weeklyNew), label: '最近七期通过' },
                { value: highRatio == null ? '—' : `${highRatio}%`, label: '候选中高优先' },
              ]}
            />
          </div>
        </div>
        <SnapshotBars title="本期筛选结果" date={latest?.date} unit="个项目" sourceHref={discovery[0] ? routes.discoveryReport(discDate(discovery[0].id)) : undefined} rows={[
          { label:'发现项目', value:latest?.total_discovered },
          { label:'通过质量评估', value:latest?.passed_quality },
          { label:'候选清单', value:latest ? latest.candidates.length : undefined, color:'var(--color-sig-workflow)' },
          { label:'高优先级', value:latest?.high_priority, color:'var(--color-impact)' },
        ]} note="来源：本期发现报告。发现与质量评估为去重前数量，候选清单与高优先级为去除已监控项目并去重后的数量。" />
      </header>

      {discovery.length === 0 ? (
        <section class="py-16">
          <div class="border border-dashed border-hairline py-16 px-8 text-center">
            <p class="tp-item text-ink-2">还没有发现记录</p>
            <p class="tp-meta mt-2">发现管线尚未产出数据。可以稍后再来,或先看趋势报告。</p>
            <a href={routes.reports()} class="tp-link inline-block mt-5">去看趋势报告 →</a>
          </div>
        </section>
      ) : (
        <>
          <!-- 本周值得关注:三栏白卡 -->
          {featured.length > 0 && (
            <section class="py-12">
              <div class="flex items-baseline justify-between mb-8">
                <h2 class="tp-section">本周值得关注</h2>
                <a href={latest ? routes.discoveryReport(latest.date) : '#'} class="tp-link">0{featured.length} 个重点项目 →</a>
              </div>
              <div class="grid md:grid-cols-3 gap-6">
                {featured.map((p) => (
                  <a href={latest ? routes.discoveryReport(latest.date) : '#'} class="tp-card p-6 flex flex-col min-h-[220px] group">
                    <h3 class="tp-mono !text-[17px] font-medium group-hover:text-accent transition-colors truncate">{p.name || p.repo}</h3>
                    <p class="tp-mono text-ink-3 mt-1 truncate">{p.repo}</p>
                    <p class="tp-meta text-ink-2 mt-4 line-clamp-3">{p.highlight?.one_liner || p.highlight?.summary || p.description}</p>
                    <div class="mt-auto pt-5 flex items-baseline justify-between">
                      <span class="tp-mono text-ink-2">★ {formatNumber(p.stars ?? 0)}</span>
                      {p.stars_growth_7d != null && p.stars_growth_7d > 0 && (
                        <span class="tp-mono text-accent">+{formatNumber(p.stars_growth_7d)} / 7d</span>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- 发现记录 -->
          <section class="py-12">
            <div class="flex items-baseline justify-between mb-8">
              <h2 class="tp-section">发现记录 <span class="tp-num text-[22px] text-ink-3 ml-1">{discovery.length}</span></h2>
              <span class="tp-meta">每期一行,点开看完整候选列表</span>
            </div>
            <div class="grid sm:grid-cols-3 gap-x-8 gap-y-6">
              {discovery.slice(0, 12).map((e, i) => {
                const r = e.data;
                return (
                  <a href={routes.discoveryReport(discDate(e.id))} class:list={['tp-row', i > 2 && 'border-t border-hairline']}>
                    <div class="flex items-baseline justify-between">
                      <span class="tp-item text-[18px]">{r.date}</span>
                      <span class="tp-mono text-ink-3">0{String(discovery.indexOf(e) + 1).slice(-2) || ''}</span>
                    </div>
                    <div class="flex gap-5 mt-2">
                      <span class="tp-mono text-ink-2">{r.passed_quality ?? r.candidates.length} 候选</span>
                      <span class="tp-mono tp-impact-high">{r.high_priority ?? 0} 高优先</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        </>
      )}
    </div>

    <!-- Rail:筛选(静态锚点 + 说明) -->
    <aside class="tp-rail">
      <h2 class="tp-item mb-6">筛选</h2>
      <div class="pb-6">
        <h3 class="tp-mono text-ink-2 mb-3">日期</h3>
        <div class="space-y-2">
          {discovery.slice(0, 5).map((e) => (
            <a href={routes.discoveryReport(discDate(e.id))} class="tp-mono text-ink-2 hover:text-accent transition-colors block">
              {discDate(e.id)}
            </a>
          ))}
        </div>
      </div>
      <div class="py-6">
        <h3 class="tp-mono text-ink-2 mb-3">优先级</h3>
        <p class="tp-mono text-accent">仅高优先</p>
        <p class="tp-meta mt-2">高优先 = 质量分与增长同时达标</p>
      </div>
      <div class="py-6">
        <h3 class="tp-mono text-ink-2 mb-3">排序</h3>
        <p class="tp-mono text-accent">按质量分</p>
        <p class="tp-mono text-ink-3 mt-2">按 star 增长</p>
      </div>
      <p class="tp-meta mt-6">候选项目经质量过滤(去重、活跃度、license)后入库。</p>
    </aside>
  </div>
</BaseLayout>
