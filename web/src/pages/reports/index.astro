---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReportPicker from '../../components/report/ReportPicker.astro';
---
<BaseLayout fillViewport={false} title="趋势报告" description="按日期查阅 TrendPulse 日报与周报">
  <div class="tp-shell report-archive">
    <header class="report-archive-header">
      <h1 class="tp-h1">趋势报告</h1>
      <p>选一个日期，回到那一天的变化。</p>
    </header>
    <ReportPicker />
  </div>
</BaseLayout>
<style>
  .report-archive { padding-top:32px; padding-bottom:16px; }
  .report-archive-header { display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding-bottom:40px; }
  .report-archive-header h1 { font-size:36px; }
  .report-archive-header p { color:var(--color-ink-2); font-size:14px; }
  @media(max-width:700px) { .report-archive-header { display:block; padding-bottom:28px; } .report-archive-header p { margin-top:12px; } }
</style>
