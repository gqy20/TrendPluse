---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ReadingNav from '../../../components/report/ReadingNav.astro';
import ReportIntro from '../../../components/report/ReportIntro.astro';
import Rating from '../../../components/report/Rating.astro';
import WeeklySignalChart from '../../../components/report/WeeklySignalChart.astro';
import StatRow from '../../../components/ui/StatRow.astro';
import SignalDrawer from '../../../components/report/SignalDrawer.astro';
import SignalTable from '../../../components/report/SignalTable.astro';
import SignalTypeBar from '../../../components/report/SignalTypeBar.astro';
import { routes } from '../../../lib/path';
import { repoUrl } from '../../../lib/format';

export async function getStaticPaths() {
  const weekly = await getCollection('weekly');
  const daily = await getCollection('daily');
  return weekly.map((entry) => {
    // entry.id 被 loader 小写化,路由参数用小写;周计算用数据里的 week_id(大写)
    const weekId = entry.id.replace(/^weekly-/, '');
    const canonical = entry.data.week_id || weekId.toUpperCase();
    const [, y, wk] = canonical.match(/^(\d{4})-W(\d{2})$/) || [];
    return { params: { week: weekId }, props: { entry, y, wk, daily } };
  });
}

interface Props {
  entry: CollectionEntry<'weekly'>;
  y?: string;
  wk?: string;
  daily: CollectionEntry<'daily'>[];
}
const { entry, daily } = Astro.props;
const w = entry.data;

const allSignals = [...w.engineering_signals, ...w.research_signals].sort(
  (a, b) => (b.impact_score || 0) - (a.impact_score || 0)
);

const weekDays = daily
  .filter(e => e.data.date >= w.start_date && e.data.date <= w.end_date)
  .sort((a, b) => a.data.date.localeCompare(b.data.date));

// 活跃仓库榜:只展示有 commit 的仓库,条形宽度以最大值为基准
const topReposAll = w.weekly_activity?.top_repos ?? [];
const topRepos = topReposAll.filter((r) => (r.commits ?? 0) > 0).slice(0, 6);
const maxCommits = Math.max(1, ...topRepos.map((r) => r.commits || 0));
// 空周:无信号且无趋势时的整页空态
const isEmptyWeek = allSignals.length === 0 && w.core_trends.length === 0;

---

<BaseLayout title={`周报 · ${w.week_id}`} description={w.summary_brief?.slice(0, 150)}>
  <div class="report-layout tp-shell">
  <ReadingNav mode="weekly" date={w.start_date} label="周报" sections={[
    { id: 'trends', label: '核心趋势', show: w.core_trends.length > 0 },
    { id: 'repos', label: '活跃仓库', show: topRepos.length > 0 },
    { id: 'signals', label: '全部信号', show: allSignals.length > 0 },
  ]} />
  <article class="report-reading pt-12 pb-8">
    <div class="min-w-0">
      <!-- Hero:核心结论 -->
      <header id="overview" class="hero-data pb-10">
        <div>
        <ReportIntro summary={w.summary_brief} fallback="一周趋势" />
        <div class="mt-8">
          <StatRow
            stats={[
              { value: w.daily_reports_count ?? 0, label: '日报' },
              { value: w.total_prs_analyzed ?? 0, label: 'PR' },
              { value: w.total_commits ?? 0, label: 'Commits' },
              { value: w.total_releases ?? 0, label: '发布' },
            ]}
          />
        </div>
        </div>
      <div class="hero-week-chart" id="weekmap">
        <WeeklySignalChart compact start={w.start_date} end={w.end_date} reports={weekDays.map(day => ({ date:day.data.date, count:day.data.stats.total_signals, url:routes.daily(day.id.replace(/^report-/, '')) }))} />
      </div>
      </header>

      <!-- 空周:解释为什么是空的,给下一步(设计稿 UX States) -->
      {isEmptyWeek && (
        <section class="py-14">
          <div class="border border-dashed border-hairline py-14 px-8 text-center">
            <p class="tp-item text-ink-2">这一周没有留下信号</p>
            <p class="tp-meta mt-2">该周期内监控仓库未产生满足阈值的活动,或管线停跑。可以先回到日报或查看监控仓库列表。</p>
            <div class="mt-5 flex justify-center gap-6">
              <a href={routes.reports()} class="tp-link">回到报告列表 →</a>
              <a href={routes.repos()} class="tp-link">监控仓库 →</a>
            </div>
          </div>
        </section>
      )}

      <!-- 核心趋势 -->
      {w.core_trends.length > 0 && (
        <section class="py-12 scroll-mt-6" id="trends">
          <div class="flex items-baseline justify-between mb-8">
            <h2 class="tp-section">核心趋势 <span class="tp-num text-[22px] text-ink-3 ml-1">{String(w.core_trends.length).padStart(2, '0')}</span></h2>
            <span class="tp-meta">本周提炼的方向性判断。</span>
          </div>
          <div class="space-y-0">
            {w.core_trends.map((t, i) => (
              <div class="tp-row border-b border-hairline last:border-b-0 grid md:grid-cols-[80px_110px_minmax(0,1fr)_120px] gap-4 items-start">
                <span class="tp-num text-[34px] text-ink">{String(i + 1).padStart(2, '0')}</span>
                <span class="tp-tag pt-2">{t.theme}</span>
                <div>
                  <h3 class="tp-item">{t.title}</h3>
                  <p class="text-[15px] text-ink-2 leading-relaxed mt-2">{t.description}</p>
                  {allSignals.some(s => t.signal_ids.includes(s.id)) && <details class="mt-3">
                    <summary class="tp-link cursor-pointer py-2">查看支撑信号</summary>
                    <div class="flex flex-col items-start gap-2 mt-2">
                      {allSignals.filter(s => t.signal_ids.includes(s.id)).map(s => <button type="button" class="text-left text-[14px] text-accent py-2 cursor-pointer" data-signal-detail={s.id}>{s.title} →</button>)}
                    </div>
                  </details> }
                </div>
                <div class="pt-2 flex items-center gap-3"><span class="tp-meta">影响</span><Rating value={t.impact_level} /></div>
              </div>
            ))}
          </div>
        </section>
      )}


      <!-- 本周活跃仓库:条形榜 -->
      {topRepos.length > 0 && (
        <section class="py-12 scroll-mt-6" id="repos">
          <div class="flex items-baseline justify-between mb-8">
            <h2 class="tp-section">本周活跃仓库</h2>
            <span class="tp-meta">{w.weekly_activity?.active_repos_count ?? 0} 个仓库 · {w.weekly_activity?.total_commits ?? 0} commits</span>
          </div>
          <div class="space-y-5 max-w-[880px]">
            {topRepos.slice(0, 6).map((r) => (
              <div class="grid grid-cols-[minmax(0,1fr)_60px] items-center gap-4">
                <div>
                  <a href={repoUrl(r.repo)} target="_blank" rel="noopener" class="tp-mono text-ink hover:text-accent transition-colors">{r.repo}</a>
                  <div class="h-[6px] bg-hairline mt-2">
                    <div class="h-full bg-ink" style={`width:${Math.round(((r.commits || 0) / maxCommits) * 100)}%`} />
                  </div>
                </div>
                <span class="tp-num text-[24px] text-right">{r.commits}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 全部信号 -->
      {allSignals.length > 0 && (
        <section class="py-12 scroll-mt-6" id="signals">
          <div class="flex items-baseline justify-between mb-6">
            <h2 class="tp-section">全部信号 <span class="tp-num text-[22px] text-ink-3 ml-1">{allSignals.length}</span></h2>
          </div>
          <div class="mb-6"><SignalTypeBar signals={allSignals} period={`${w.start_date} 至 ${w.end_date}`} targetId="signals" sourceDescription="本期周报汇总的工程与研究信号" /></div>
          <SignalTable signals={allSignals} time={`${w.start_date.slice(5)}+`} limit={12} clickable filterable />
        </section>
      )}
    </div>

  </article>
  </div>

  <script is:inline type="application/json" id="tp-signals-data" set:html={JSON.stringify(allSignals).replace(/</g, "\\u003c")} />
  <SignalDrawer />
</BaseLayout>
