---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatRow from '../../../components/ui/StatRow.astro';
import SignalTable from '../../../components/report/SignalTable.astro';
import { routes } from '../../../lib/path';
import { repoUrl } from '../../../lib/format';

export async function getStaticPaths() {
  const weekly = await getCollection('weekly');
  const daily = await getCollection('daily');
  return weekly.map((entry) => {
    // entry.id 被 loader 小写化,路由参数用小写;周计算用数据里的 week_id(大写)
    const weekId = entry.id.replace(/^weekly-/, '');
    const canonical = entry.data.week_id || weekId.toUpperCase();
    const [, y, wk] = canonical.match(/^(\d{4})-W(\d{2})$/) || [];
    return { params: { week: weekId }, props: { entry, y, wk, daily } };
  });
}

interface Props {
  entry: CollectionEntry<'weekly'>;
  y?: string;
  wk?: string;
  daily: CollectionEntry<'daily'>[];
}
const { entry, y, wk, daily } = Astro.props;
const w = entry.data;

const allSignals = [...w.engineering_signals, ...w.research_signals].sort(
  (a, b) => (b.impact_score || 0) - (a.impact_score || 0)
);

// 周内各日信号量:用于 7 日趋势地图(ISO 周:周一为一,与后端 get_week_id 对齐)
function isoWeekOfDay(dateStr: string): number | null {
  const d = new Date(`${dateStr}T00:00:00Z`);
  if (Number.isNaN(d.getTime())) return null;
  const day = d.getUTCDay();
  return day === 0 ? 7 : day;
}
const weekDays = daily
  .filter((e) => {
    if (!y || !wk) return false;
    const iw = isoWeekOfDay(e.data.date);
    if (iw == null) return false;
    // 粗筛同 ISO 周:取该日所在周的周一,比较年-周
    const d = new Date(`${e.data.date}T00:00:00Z`);
    const monday = new Date(d);
    monday.setUTCDate(d.getUTCDate() - ((d.getUTCDay() + 6) % 7));
    const my = monday.getUTCFullYear();
    const jan4 = new Date(Date.UTC(my, 0, 4));
    const week1Mon = new Date(jan4);
    week1Mon.setUTCDate(jan4.getUTCDate() - ((jan4.getUTCDay() + 6) % 7));
    const weekNo = Math.round((monday.getTime() - week1Mon.getTime()) / 604800000) + 1;
    return `${my}-W${String(weekNo).padStart(2, '0')}` === `${y}-W${wk}`;
  })
  .sort((a, b) => a.data.date.localeCompare(b.data.date));

const DAY_LABELS = ['MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT', 'SUN'];
const dayCounts = DAY_LABELS.map(
  (_, i) => weekDays.find((e) => isoWeekOfDay(e.data.date) === i + 1)?.data.stats.total_signals ?? 0
);
const maxDay = Math.max(1, ...dayCounts);

// 活跃仓库榜:只展示有 commit 的仓库,条形宽度以最大值为基准
const topReposAll = w.weekly_activity?.top_repos ?? [];
const topRepos = topReposAll.filter((r) => (r.commits ?? 0) > 0).slice(0, 6);
const maxCommits = Math.max(1, ...topRepos.map((r) => r.commits || 0));
// 空周:无信号且无趋势时的整页空态
const isEmptyWeek = allSignals.length === 0 && w.core_trends.length === 0;

const sentences = (w.summary_brief || '').split('。').filter(Boolean);
const headline = sentences[0] ? sentences[0] + '。' : `周报 · ${w.week_id}`;
const lead = sentences.slice(1).join('。');
---

<BaseLayout title={`周报 · ${w.week_id}`} description={w.summary_brief?.slice(0, 150)}>
  <article class="tp-shell tp-grid pt-12 pb-8">
    <div class="min-w-0">
      <!-- Hero:日 / 周 切换 + 核心结论 -->
      <header class="pb-10">
        <div class="flex items-center justify-between mb-5">
          <p class="tp-eyebrow">TREND REPORT · {w.week_id} · {w.start_date} – {w.end_date}</p>
          <!-- 日/周切换器 -->
          <nav class="tp-mono flex items-center border border-hairline">
            <a href={routes.reports()} class="px-3 py-1 text-ink-3 hover:text-ink transition-colors">日</a>
            <span class="px-3 py-1 bg-ink text-paper">周</span>
          </nav>
        </div>
        <h1 class="tp-h1 !text-[clamp(30px,3.1vw,50px)] !leading-[1.18] !font-normal max-w-[860px]">{headline}</h1>
        {lead && <p class="tp-body text-ink-2 mt-5 max-w-[680px]">{lead}。</p>}
        <div class="mt-8">
          <StatRow
            stats={[
              { value: w.daily_reports_count ?? 0, label: '日报' },
              { value: w.total_prs_analyzed ?? 0, label: 'PR' },
              { value: w.total_commits ?? 0, label: 'Commits' },
              { value: w.total_releases ?? 0, label: '发布' },
            ]}
          />
        </div>
      </header>

      <!-- 空周:解释为什么是空的,给下一步(设计稿 UX States) -->
      {isEmptyWeek && (
        <section class="border-t border-hairline py-14">
          <div class="border border-dashed border-hairline py-14 px-8 text-center">
            <p class="tp-item text-ink-2">这一周没有留下信号</p>
            <p class="tp-meta mt-2">该周期内监控仓库未产生满足阈值的活动,或管线停跑。可以先回到日报或查看监控仓库列表。</p>
            <div class="mt-5 flex justify-center gap-6">
              <a href={routes.reports()} class="tp-link">回到报告列表 →</a>
              <a href={routes.repos()} class="tp-link">监控仓库 →</a>
            </div>
          </div>
        </section>
      )}

      <!-- 核心趋势 -->
      {w.core_trends.length > 0 && (
        <section class="border-t border-hairline py-12">
          <div class="flex items-baseline justify-between mb-8">
            <h2 class="tp-section">核心趋势 <span class="tp-num text-[22px] text-ink-3 ml-1">{String(w.core_trends.length).padStart(2, '0')}</span></h2>
            <span class="tp-meta">本周提炼的方向性判断。</span>
          </div>
          <div class="space-y-0">
            {w.core_trends.map((t, i) => (
              <div class="tp-row border-b border-hairline grid md:grid-cols-[80px_110px_minmax(0,1fr)_120px] gap-4 items-start">
                <span class="tp-num text-[34px] text-ink">{String(i + 1).padStart(2, '0')}</span>
                <span class="tp-tag pt-2">{t.theme}</span>
                <div>
                  <h3 class="tp-item">{t.title}</h3>
                  <p class="tp-meta mt-2">{t.description}</p>
                </div>
                <div class="pt-2 hidden md:block">
                  <!-- 热度虚线:长度随影响级别,红=强(≥4)蓝=中 -->
                  <div class:list={['border-t-2 border-dashed', (t.impact_level ?? 3) >= 4 ? 'border-impact' : 'border-accent']} style={`width:${Math.min(100, ((t.impact_level ?? 3) / 5) * 100)}%`} />
                  <span class="tp-mono text-ink-3 mt-1.5 block">影响 {t.impact_level ?? '—'}/5</span>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 7 日趋势地图 -->
      {weekDays.length > 0 && (
        <section class="border-t border-hairline py-12">
          <div class="flex items-baseline justify-between mb-8">
            <h2 class="tp-section">7 日信号分布</h2>
            <span class="tp-meta">每天不是一个点,而是趋势形成过程的一层证据。</span>
          </div>
          <div class="flex items-end gap-3 sm:gap-5 h-[140px]">
            {dayCounts.map((c, i) => (
              <div class="flex-1 flex flex-col items-center gap-2 h-full justify-end">
                <span class="tp-mono text-ink-3">{c || ''}</span>
                <div
                  class:list={['w-full max-w-[34px] transition-all', c > 0 ? 'bg-accent/80' : 'bg-hairline']}
                  style={`height:${Math.max(3, (c / maxDay) * 88)}%`}
                />
                <span class="tp-mono text-ink-3">{DAY_LABELS[i]}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 本周活跃仓库:条形榜 -->
      {topRepos.length > 0 && (
        <section class="border-t border-hairline py-12">
          <div class="flex items-baseline justify-between mb-8">
            <h2 class="tp-section">本周活跃仓库</h2>
            <span class="tp-meta">{w.weekly_activity?.active_repos_count ?? 0} 个仓库 · {w.weekly_activity?.total_commits ?? 0} commits</span>
          </div>
          <div class="space-y-5 max-w-[640px]">
            {topRepos.slice(0, 6).map((r) => (
              <div class="grid grid-cols-[minmax(0,1fr)_60px] items-center gap-4">
                <div>
                  <a href={repoUrl(r.repo)} target="_blank" rel="noopener" class="tp-mono text-ink hover:text-accent transition-colors">{r.repo}</a>
                  <div class="h-[6px] bg-hairline mt-2">
                    <div class="h-full bg-ink" style={`width:${Math.round(((r.commits || 0) / maxCommits) * 100)}%`} />
                  </div>
                </div>
                <span class="tp-num text-[24px] text-right">{r.commits}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 全部信号 -->
      {allSignals.length > 0 && (
        <section class="border-t border-hairline py-12">
          <div class="flex items-baseline justify-between mb-6">
            <h2 class="tp-section">全部信号 <span class="tp-num text-[22px] text-ink-3 ml-1">{allSignals.length}</span></h2>
          </div>
          <SignalTable signals={allSignals} time={`${w.start_date.slice(5)}+`} limit={12} />
        </section>
      )}
    </div>

    <!-- ═══ Rail ═══ -->
    <aside class="tp-rail">
      <h2 class="tp-item mb-6">本期信息</h2>
      <dl class="space-y-2.5">
        <div class="flex justify-between gap-3"><dt class="tp-meta">周</dt><dd class="tp-mono text-ink">{w.week_id}</dd></div>
        <div class="flex justify-between gap-3"><dt class="tp-meta">周期</dt><dd class="tp-mono text-ink text-right">{w.start_date}<br />{w.end_date}</dd></div>
        <div class="flex justify-between gap-3"><dt class="tp-meta">信号</dt><dd class="tp-mono text-ink">{allSignals.length}</dd></div>
        <div class="flex justify-between gap-3"><dt class="tp-meta">高影响</dt><dd class="tp-mono text-ink">{w.high_impact_signals ?? '—'}</dd></div>
      </dl>
      <div class="border-t border-hairline mt-8 pt-8">
        <h2 class="tp-mono text-ink mb-4">本期日报</h2>
        {weekDays.map((e) => (
          <a href={routes.daily(e.data.date)} class="tp-row border-b border-hairline flex justify-between">
            <span class="tp-mono text-ink">{e.data.date.slice(5)}</span>
            <span class="tp-mono text-ink-3">{e.data.stats.total_signals ?? 0} 信号</span>
          </a>
        ))}
        {weekDays.length === 0 && <p class="tp-meta text-ink-3">该周无日报归档</p>}
      </div>
      <a href={routes.reports()} class="tp-link mt-8 block">浏览全部报告 →</a>
    </aside>
  </article>
</BaseLayout>
