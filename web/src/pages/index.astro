---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { routes } from '../lib/path';
import { loadRepos, groupReposByOwner } from '../lib/repos';
import StatRow from '../components/ui/StatRow.astro';
import HeroArt from '../components/ui/HeroArt.astro';
import { signalLabel } from '../lib/format';

const daily = (await getCollection('daily')).sort((a, b) => b.id.localeCompare(a.id));
const weekly = (await getCollection('weekly')).sort((a, b) => b.id.localeCompare(a.id));
const discovery = (await getCollection('discovery')).sort((a, b) => b.id.localeCompare(a.id));

const latest = daily[0];
const latestData = latest?.data;
const latestWeekly = weekly[0]?.data;
const dailyDate = (id: string) => id.replace(/^report-/, '');
const weeklyId = (id: string) => id.replace(/^weekly-/, '');

const repos = loadRepos();
const ownerGroups = groupReposByOwner(repos);

// 今日最重要变化:最新日报中影响分最高的信号
const allSignals = latestData
  ? [...latestData.engineering_signals, ...latestData.research_signals, ...latestData.commit_signals, ...latestData.release_signals]
  : [];
const topSignal = [...allSignals].sort((a, b) => (b.impact_score ?? 0) - (a.impact_score ?? 0))[0];
const highImpact = latestData?.stats.high_impact_signals ?? 0;

// 项目发现:最新一期推荐项目(推荐优先,其次 7 日 star 增长)
const latestDiscovery = discovery[0]?.data;
const featured = latestDiscovery
  ? [...latestDiscovery.candidates]
      .sort((a, b) => (Number(b.recommended) - Number(a.recommended)) || (b.stars_growth_7d ?? 0) - (a.stars_growth_7d ?? 0))
      .slice(0, 3)
  : [];
---

<BaseLayout title="首页">
  <div class="tp-shell tp-grid pt-12 pb-4">
    <!-- ═══ 主栏 ═══ -->
    <div class="min-w-0">
      <!-- Hero -->
      <section class="grid lg:grid-cols-[minmax(0,1fr)_330px] gap-10 items-end pb-12">
        <div>
          <p class="tp-eyebrow mb-5">SIGNAL · INSIGHT · NEXT</p>
          <h1 class="tp-h1">更早看到变化，<br />更从容地创造未来。</h1>
          <p class="tp-body text-ink-2 mt-6 max-w-[560px]">
            每日追踪 GitHub 上 AI 编程生态的趋势信号——从产品发布、技术进展到行业应用，捕捉正在发生的变化。
          </p>
          <a href={latest ? routes.daily(dailyDate(latest.id)) : routes.reports()} class="tp-link inline-block mt-6">
            阅读今日报告 →
          </a>
        </div>
        <HeroArt class="hidden lg:block h-[300px] ml-auto w-[330px]" />
      </section>

      <!-- 统计条 -->
      <div class="border-y border-hairline py-7">
        <StatRow
          stats={[
            { value: daily.length, label: '日报', href: routes.reports() },
            { value: weekly.length, label: '周报', href: routes.reports() },
            { value: discovery.length, label: '项目发现', href: routes.discovery() },
            { value: repos.length, label: '监控仓库', href: routes.repos() },
          ]}
        />
      </div>

      <!-- 今日情报:大编号 01 + 今日最重要变化 -->
      {latestData && topSignal && (
        <section class="py-14">
          <div class="grid md:grid-cols-[150px_minmax(0,1fr)] gap-6">
            <div class="tp-num text-[90px] text-ink">01</div>
            <div>
              <p class="tp-tag mb-3">今日最重要变化</p>
              <h2 class="tp-h2">{topSignal.title}</h2>
              <p class="tp-body text-ink-2 mt-4 max-w-[640px] line-clamp-3">{topSignal.why_it_matters}</p>
              <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mt-5">
                <a href={routes.daily(dailyDate(latest!.id))} class="tp-link">阅读今日报告 →</a>
                <span class="tp-meta">{latestData.date} · {signalLabel(topSignal.type)} · 影响 {topSignal.impact_score}/5</span>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- 项目发现 -->
      {featured.length > 0 && (
        <section class="border-t border-hairline pt-12 pb-14">
          <div class="flex items-baseline justify-between mb-8">
            <h2 class="tp-section">项目发现</h2>
            <a href={routes.discovery()} class="tp-link">全部 {discovery.length} 期 →</a>
          </div>
          <div class="grid md:grid-cols-3 gap-8">
            {
              featured.map((p, i) => (
                <a href={routes.discoveryReport(latestDiscovery!.date)} class="tp-row border-t border-hairline">
                  <div class="tp-num text-[40px] text-ink-3 mb-3">0{i + 1}</div>
                  <h3 class="tp-item">{p.name}</h3>
                  <p class="tp-meta mt-2 line-clamp-2">{p.description}</p>
                  {p.stars_growth_7d != null && p.stars_growth_7d > 0 && (
                    <p class="tp-mono text-accent mt-2">+{p.stars_growth_7d.toLocaleString('en-US')} ★ / 7d</p>
                  )}
                </a>
              ))
            }
          </div>
        </section>
      )}

      <!-- 监控中的世界:组织视图 -->
      <section class="border-t border-hairline pt-12">
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="tp-section">监控中的世界</h2>
          <a href={routes.repos()} class="tp-link">{repos.length} 个仓库 →</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-10 gap-y-8 pb-16">
          {
            ownerGroups.slice(0, 6).map(([owner, list]) => (
              <div>
                <a href={routes.repos()} class="tp-mono text-ink hover:text-accent transition-colors">
                  {owner}
                </a>
                <p class="tp-meta mt-1.5">{list.length} 个仓库</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <!-- ═══ 右侧 Rail ═══ -->
    <aside class="tp-rail">
      <h2 class="tp-item mb-6">今日索引</h2>
      {
        allSignals
          .sort((a, b) => (b.impact_score ?? 0) - (a.impact_score ?? 0))
          .slice(0, 4)
          .map((s, i) => (
            <a href={latest ? routes.daily(dailyDate(latest.id)) : '#'} class="tp-row border-b border-hairline">
              <div class="flex items-start gap-3">
                <span class="tp-num text-[26px] text-ink-3">0{i + 1}</span>
                <span class="tp-meta text-ink leading-snug">{s.title}</span>
              </div>
            </a>
          ))
      }
      {
        latestData && (
          <p class="tp-meta mt-6">
            今日共 {latestData.stats.total_signals ?? 0} 个信号<br />
            {highImpact} 个高影响变化
          </p>
        )
      }
      {latestWeekly && weekly[0] && (
        <a href={routes.weekly(weeklyId(weekly[0].id))} class="tp-link mt-6 block">最新周报 {latestWeekly.week_id} →</a>
      )}
    </aside>
  </div>
</BaseLayout>
