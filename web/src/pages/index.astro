---
import SnapshotBars from '../components/data/SnapshotBars.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { routes } from '../lib/path';
import { loadRepos, groupReposByOwner } from '../lib/repos';
import { formatNumber } from '../lib/format';

const daily = (await getCollection('daily')).sort((a, b) => b.id.localeCompare(a.id));
const weekly = (await getCollection('weekly')).sort((a, b) => b.id.localeCompare(a.id));
const discovery = (await getCollection('discovery')).sort((a, b) => b.id.localeCompare(a.id));

const latest = daily[0];
const latestData = latest?.data;
const dailyDate = (id: string) => id.replace(/^report-/, '');

const repos = loadRepos();
const ownerGroups = groupReposByOwner(repos);

// 今日最重要变化:最新日报中影响分最高的信号
const allSignals = latestData
  ? [...latestData.engineering_signals, ...latestData.research_signals, ...latestData.commit_signals, ...latestData.release_signals]
  : [];
const topSignal = [...allSignals].sort((a, b) => (b.impact_score ?? 0) - (a.impact_score ?? 0))[0];

// 项目发现:最新一期推荐项目
const latestDiscovery = discovery[0]?.data;
const featured = latestDiscovery
  ? [...latestDiscovery.candidates]
      .sort((a, b) => (Number(b.recommended) - Number(a.recommended)) || (b.stars_growth_7d ?? 0) - (a.stars_growth_7d ?? 0))
      .slice(0, 3)
  : [];

// 监控动态:最新一期高影响信号涉及的仓库
const recentRepos = [...allSignals]
  .sort((a, b) => (b.impact_score ?? 0) - (a.impact_score ?? 0))
  .filter((s) => s.related_repos[0])
  .slice(0, 3)
  .map((s) => ({ repo: s.related_repos[0], title: s.title }));

const statNum = (v: number) => formatNumber(v);
---

<BaseLayout title="首页">
  <div class="tp-shell tp-grid pt-10 pb-4">
    <!-- ═══ 主栏 ═══ -->
    <div class="min-w-0">
      <!-- Hero:衬线大标题 + Signal Field 视觉(设计稿 02 · Home) -->
      <section class="hero-data pb-12">
        <div>
          <h1 class="tp-h1">让 AI 趋势<br />更早被看见</h1>
          <p class="tp-body text-ink-2 mt-6 max-w-[720px]">
            从海量开源、产品与研究信号中，捕捉真正重要的变化。<br />
            TrendPulse 持续追踪 AI 编程生态，帮助你更快理解趋势与机会。
          </p>
        </div>
        <SnapshotBars title="最新信号来源" date={latestData?.date} unit="条" sourceHref={latest ? routes.daily(dailyDate(latest.id)) : undefined} rows={[
          { label:'PR 信号', value:latestData?.stats.pr_count, color:'var(--color-accent)' },
          { label:'Commit 信号', value:latestData?.stats.commit_count, color:'var(--color-sig-workflow)' },
          { label:'Release 信号', value:latestData?.stats.release_count, color:'var(--color-sig-release)' },
        ]} note="来源：最新日报按来源统计的信号数。柱长与数量成比例，不与归并后的明细数量混用。" />
      </section>

      <!-- 统计行:mono 数字 + 竖分隔 -->
      <div class="pb-14 flex flex-wrap gap-y-4">
        {[
          { v: statNum(daily.length), label: '日报', href: routes.reports() },
          { v: statNum(weekly.length), label: '周报', href: routes.reports() },
          { v: statNum(discovery.length), label: '项目', href: routes.discovery() },
          { v: statNum(repos.length), label: '仓库', href: routes.repos() },
        ].map((s, i) => (
          <div class:list={['flex items-start gap-4', i > 0 && 'pl-7 sm:pl-9 relative']}>
            <a href={s.href} class="tp-num text-[29px] hover:text-accent transition-colors">{s.v}</a>
            <span class="tp-mono text-ink-2 mt-2.5">{s.label}</span>
          </div>
        ))}
      </div>

      <!-- 三栏卡片:最新报告 / 发现项目 / 监控动态(设计稿 Approved Home Card) -->
      <section class="grid md:grid-cols-3 gap-6 pb-14">
        <!-- 最新报告 -->
        {latestData && topSignal && (
          <a href={routes.daily(dailyDate(latest!.id))} class="tp-card p-6 flex flex-col group home-summary-card">
            <header class="home-card-header">
              <h2>最新报告</h2>
              <div class="home-card-count">
                <span>{latestData.stats.total_signals ?? 0} 个信号</span>
                <small>{latestData.stats.high_impact_signals ?? 0} 重点 · {latestData.stats.total_prs_analyzed ?? 0} PR</small>
              </div>
            </header>
            <p class="tp-mono text-ink-3 mt-5">{latestData.date}</p>
            <p class="tp-mono text-[20px] leading-[1.45] mt-3 group-hover:text-accent transition-colors">{topSignal.title}</p>
            <p class="text-[14px] leading-[1.7] text-ink-2 mt-4 line-clamp-3">{topSignal.why_it_matters}</p>
          </a>
        )}

        <!-- 发现项目 -->
        {featured.length > 0 && (
          <a href={routes.discovery()} class="tp-card p-6 flex flex-col group home-summary-card">
            <header class="home-card-header">
              <h2>发现项目</h2>
              <span class="home-card-count">{discovery.length} 期发现 →</span>
            </header>
            {featured.map((p) => (
              <div class="mt-5 flex items-baseline justify-between gap-3">
                <div class="min-w-0">
                  <p class="tp-mono text-[16px] font-medium group-hover:text-accent transition-colors truncate">{p.name || p.repo}</p>
                  <p class="tp-mono text-ink-3 text-[13px] mt-0.5 truncate">{p.description}</p>
                </div>
                {p.stars_growth_7d != null && p.stars_growth_7d > 0 && (
                  <span class="tp-mono text-ink-3 shrink-0">+{formatNumber(p.stars_growth_7d)}</span>
                )}
              </div>
            ))}
          </a>
        )}

        <!-- 监控动态 -->
        {recentRepos.length > 0 && (
          <a href={routes.repos()} class="tp-card p-6 flex flex-col group home-summary-card">
            <header class="home-card-header">
              <h2>监控动态</h2>
              <span class="home-card-count">{repos.length} 个仓库 →</span>
            </header>
            {recentRepos.map((r) => (
              <div class="mt-5 flex items-baseline justify-between gap-3">
                <p class="tp-mono text-[15px] font-medium group-hover:text-accent transition-colors truncate">{r.repo}</p>
                <span class="tp-mono text-ink-3 shrink-0">{latestData?.date.slice(5) ?? ''}</span>
              </div>
            ))}
            <p class="text-[13px] text-ink-2 mt-4 line-clamp-2">{recentRepos[0]?.title}</p>
          </a>
        )}
      </section>

      <!-- 监控中的世界:三列机构 -->
      <section class="pt-10">
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="tp-section">监控中的世界</h2>
          <a href={routes.repos()} class="tp-link">{repos.length} 个仓库 →</a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-10 gap-y-8 pb-16">
          {
            ownerGroups.slice(0, 6).map(([owner, list]) => (
              <div>
                <a href={routes.repos()} class="tp-mono text-[15px] text-ink hover:text-accent transition-colors">
                  {owner}
                </a>
                <p class="tp-mono text-ink-3 mt-1">{list.length} 个仓库</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <!-- ═══ Rail:今日索引(设计稿 mono 28px 编号体系) ═══ -->
    <aside class="tp-rail">
      <h2 class="text-[20px] font-normal mb-6">今日索引</h2>
      {
        [...allSignals]
          .sort((a, b) => (b.impact_score ?? 0) - (a.impact_score ?? 0))
          .slice(0, 4)
          .map((s, i) => (
            <a href={latest ? routes.daily(dailyDate(latest.id)) : '#'} class="tp-row border-b border-hairline last:border-b-0">
              <span class="tp-num text-[28px] block">0{i + 1}</span>
              <span class="text-[14px] leading-[1.5] mt-2 block">{s.title}</span>
            </a>
          ))
      }
      <div class="mt-8 pt-6">
        {latestData && (
          <p class="tp-mono text-ink-2 mt-4">今日共 {latestData.stats.total_signals ?? 0} 个信号 / {latestData.stats.high_impact_signals ?? 0} 个高影响变化</p>
        )}
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .home-card-header { display:flex; justify-content:space-between; align-items:baseline; gap:12px; }
  .home-card-header h2 { font-size:20px; font-weight:500; line-height:1.4; white-space:nowrap; }
  .home-card-count { font-size:12px; color:var(--color-accent); text-align:right; font-variant-numeric:tabular-nums; }
  .home-card-count small { display:block; font-size:11px; color:var(--color-ink-2); margin-top:4px; }
  .home-summary-card { min-width:0; }
</style>
