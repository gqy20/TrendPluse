---
import { routes } from '../../lib/path';

const base = import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname;
// 去掉 base 前缀,得到根相对路径用于高亮判断
const relPath = rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath;

const nav = [
  { href: routes.home(), label: '首页', active: relPath === '' || relPath === '/' },
  { href: routes.reports(), label: '趋势报告', active: relPath.startsWith('/reports') },
  { href: routes.discovery(), label: '项目发现', active: relPath.startsWith('/discovery') },
  { href: routes.repos(), label: '监控仓库', active: relPath.startsWith('/repos') },
];
---
<header class="tp-shell relative">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-0 sm:h-[92px] py-4 sm:py-0">
    <!-- 品牌:衬线字标 + 小注 -->
    <a href={routes.home()} class="flex items-baseline gap-3 group">
      <span class="font-serif text-[21px] sm:text-[28px] font-bold tracking-tight leading-none">TrendPulse<span class="text-accent">.</span></span>
      <span class="tp-eyebrow hidden sm:inline">情报屏</span>
    </a>

    <nav class="flex items-center gap-4 sm:gap-7 text-[13px] sm:text-[15px] whitespace-nowrap order-last sm:order-none -ml-1 sm:ml-0">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'relative py-1 transition-colors whitespace-nowrap',
            item.active ? 'text-accent font-medium' : 'text-ink-2 hover:text-ink',
          ]}
        >
          {item.label}
          {item.active && <span class="absolute -bottom-[2px] left-0 right-0 h-[2px] bg-accent" />}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={routes.search()}
        data-search-trigger
        class="flex items-center gap-2 text-ink-2 hover:text-ink transition-colors min-h-[44px] min-w-[44px] justify-center sm:justify-start sm:min-h-0 sm:min-w-0"
        aria-label="搜索"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.8-3.8" /></svg>
        <span class="hidden md:inline tp-meta">探索更大的技术视野</span>
      </a>
      <a
        href="https://github.com/gqy20/TrendPluse"
        target="_blank"
        rel="noopener"
        aria-label="GitHub 仓库"
        class="inline-flex items-center justify-center w-[30px] h-[30px] rounded-full border border-hairline text-ink-2 hover:text-accent hover:border-accent transition-colors tp-mono"
      >
        T
      </a>
    </div>
  </div>
</header>
