---
import { routes } from '../../lib/path';

const base = import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname;
const relPath = rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath;

const nav = [
  { href: routes.home(), label: '首页', active: relPath === '' || relPath === '/' },
  { href: routes.reports(), label: '趋势报告', active: relPath.startsWith('/reports') },
  { href: routes.discovery(), label: '项目发现', active: relPath.startsWith('/discovery') },
  { href: routes.repos(), label: '监控仓库', active: relPath.startsWith('/repos') },
];
const iconUrl = (p: string) => `${import.meta.env.BASE_URL}assets/${p}`;
---
<header class="tp-shell w-full">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-0 sm:h-[92px] py-4 sm:py-0">
    <!-- 品牌:bolt + mono 字标(设计稿规格) -->
    <a href={routes.home()} class="flex items-center gap-2.5">
      <img src={iconUrl('bolt.svg')} alt="" width="20" height="24" class="h-[24px] w-[20px]" />
      <span class="tp-num text-[27px] tracking-tight leading-none">TrendPulse</span>
    </a>

    <!-- 导航:104px 节距,14px Sans Medium,激活蓝+下划线 -->
    <nav class="flex items-center gap-6 lg:gap-9 text-[14px] whitespace-nowrap order-last sm:order-none -ml-1 sm:ml-0">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'relative py-2 transition-colors font-medium whitespace-nowrap',
            item.active ? 'text-accent font-bold' : 'text-[#13171f] hover:text-accent',
          ]}
        >
          {item.label}
          {item.active && <span class="absolute -bottom-[14px] left-1/2 -translate-x-1/2 w-10 h-[2px] bg-accent" />}
        </a>
      ))}
    </nav>

    <!-- 搜索 + 头像:40px 圆形按钮(设计稿 Interaction 组件) -->
    <div class="flex items-center gap-3">
      <a
        href={routes.search()}
        data-search-trigger
        aria-label="搜索"
        class="inline-flex items-center justify-center size-[40px] rounded-full hover:bg-[#f1efe8] transition-colors"
      >
        <img src={iconUrl('icon-search.svg')} alt="" width="18" height="18" />
      </a>
      <a
        href="https://github.com/gqy20/TrendPluse"
        target="_blank"
        rel="noopener"
        aria-label="GitHub 仓库"
        class="inline-flex items-center justify-center size-[40px] rounded-full bg-[#f6f4ee] hover:opacity-80 transition-opacity"
      >
        <img src={iconUrl('icon-account.svg')} alt="" width="18" height="18" />
      </a>
    </div>
  </div>
  <!-- 全局分隔线:64px 边界(设计稿 y=92) -->
  <div class="border-t border-hairline" />
</header>
