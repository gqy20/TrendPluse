---
import { routes } from '../../lib/path';

const base = import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname;
// 去掉 base 前缀，得到根相对路径用于高亮判断
const relPath = rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath;

const nav = [
  { href: routes.home(), label: '首页', active: relPath === '' || relPath === '/' },
  { href: routes.reports(), label: '趋势报告', active: relPath.startsWith('/reports') },
  { href: routes.discovery(), label: '项目发现', active: relPath.startsWith('/discovery') },
  { href: routes.repos(), label: '监控仓库', active: relPath.startsWith('/repos') },
];
---
<header class="sticky top-0 z-50 backdrop-blur-md bg-[color-mix(in_oklab,var(--tp-bg)_82%,transparent)] border-b border-[var(--tp-border)]">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <a href={routes.home()} class="flex items-center gap-2 font-bold text-base hover:no-underline group">
      <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-white text-sm shadow-sm transition-transform group-hover:scale-105">⚡</span>
      <span class="tracking-tight">TrendPulse</span>
      <span class="hidden sm:inline text-[10px] font-medium uppercase tracking-wider text-[var(--tp-muted)] border border-[var(--tp-border)] rounded px-1.5 py-0.5">情报屏</span>
    </a>

    <nav class="flex items-center gap-0.5 text-sm">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'px-3 py-1.5 rounded-md transition-colors',
            item.active
              ? 'bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-200 font-medium'
              : 'text-[var(--tp-muted)] hover:text-[var(--tp-fg)] hover:bg-[var(--tp-surface-2)]',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="https://github.com/gqy20/TrendPluse"
        target="_blank"
        rel="noopener"
        class="ml-1 px-3 py-1.5 rounded-md text-[var(--tp-muted)] hover:text-[var(--tp-fg)] hover:bg-[var(--tp-surface-2)] transition-colors inline-flex items-center gap-1"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </nav>
  </div>
</header>
