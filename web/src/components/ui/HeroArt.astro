---
/**
 * Hero 视觉图:统一复用设计稿的 Signal Field SVG(不再手绘几何)。
 */
interface Props {
  class?: string;
  variant?: 'home' | 'report';
}
const { class: cls = '', variant = 'home' } = Astro.props;
const file = variant === 'report' ? 'signal-field-v3.svg' : 'signal-field.svg';
---
<img src={`${import.meta.env.BASE_URL}assets/${file}`} alt="" class={cls} />
