---
/**
 * 统计条(设计稿日报/发现/监控页统一规格):
 * mono 30px 数字 + 13px 标签，通过留白区分统计项。
 */
interface Stat {
  value: number | string;
  label: string;
  href?: string;
}
interface Props {
  stats: Stat[];
  class?: string;
}
const { stats, class: cls = '' } = Astro.props;

const fmt = (v: number | string) =>
  typeof v === 'number' ? v.toLocaleString('en-US') : v;
---
<div class:list={['flex flex-wrap items-start gap-x-10 gap-y-6', cls]}>
  {
    stats.map((s) => (
      <div class="flex items-start gap-4">
        <a href={s.href} class="tp-num text-[30px] text-[#13171f] hover:text-accent transition-colors">
          {fmt(s.value)}
        </a>
        <span class="text-[13px] text-[#7d8591] opacity-72 mt-3">{s.label}</span>
      </div>
    ))
  }
</div>
