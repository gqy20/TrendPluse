---
/**
 * 统计条:大衬线数字 + 小灰标签,竖发丝线分隔。
 * 数字与标签使用固定列起点,不依赖字符宽度对齐(Design QA 规则 03)。
 */
interface Stat {
  value: number | string;
  label: string;
  href?: string;
}
interface Props {
  stats: Stat[];
  class?: string;
}
const { stats, class: cls = '' } = Astro.props;

const fmt = (v: number | string) =>
  typeof v === 'number' ? v.toLocaleString('en-US') : v;
---
<div class:list={['flex flex-wrap items-stretch gap-y-4', cls]}>
  {
    stats.map((s, i) => (
      <div class:list={['flex items-start gap-4', i > 0 && 'pl-6 sm:pl-8 relative']}>
        {i > 0 && <span class="absolute left-0 top-1 bottom-1 w-px bg-hairline" />}
        <div>
          <a
            href={s.href}
            class="tp-num text-[34px] block hover:text-accent transition-colors"
          >
            {fmt(s.value)}
          </a>
          <div class="tp-meta mt-1.5">{s.label}</div>
        </div>
      </div>
    ))
  }
</div>
