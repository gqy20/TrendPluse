---
import type { Signal } from '../../content.config';
import {
  signalEmoji,
  signalLabel,
  signalColor,
  withAlpha,
  impactStars,
  impactLevel,
  repoUrl,
} from '../../lib/format';

interface Props {
  signal: Signal;
}
const { signal } = Astro.props;
const level = impactLevel(signal.impact_score);
const color = signalColor(signal.type);
const levelBar = {
  high: 'bg-status-high',
  medium: 'bg-status-medium',
  low: 'bg-status-low',
}[level];
const score = signal.impact_score;
---

<article class="signal-card relative rounded-lg border border-[var(--tp-border)] bg-[var(--tp-surface)] overflow-hidden hover:border-brand-300 transition-colors">
  <div class:list={['absolute top-0 left-0 right-0 h-0.5', levelBar]}></div>
  <div class="p-5">
    <div class="flex items-start gap-3">
      <span class="text-2xl leading-none flex-shrink-0 mt-0.5">{signalEmoji(signal.type)}</span>
      <div class="flex-1 min-w-0">
        <h3 class="font-semibold text-base leading-snug">{signal.title}</h3>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
          <span
            class="inline-flex items-center px-2 py-0.5 rounded-full font-medium"
            style={`background:${withAlpha(color, 0.12)};color:${color}`}
          >
            {signalLabel(signal.type)}
          </span>
          {signal.category && (
            <span class="text-[var(--tp-muted)]">{signal.category}</span>
          )}
          {score != null && (
            <span class="inline-flex items-center gap-1">
              <span class="text-status-warning tracking-tight">{impactStars(score)}</span>
              <span class="text-[var(--tp-muted)]">({score}/5)</span>
            </span>
          )}
        </div>
      </div>
    </div>

    {signal.why_it_matters && (
      <p class="mt-3 text-sm leading-relaxed text-[var(--tp-fg)] opacity-90">{signal.why_it_matters}</p>
    )}

    {signal.related_repos.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {signal.related_repos.map((r) => (
          <a
            href={repoUrl(r)}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono bg-[var(--tp-surface-2)] hover:bg-brand-50 hover:text-brand-700 dark:hover:bg-brand-900/30 transition-colors"
          >
            {r}
          </a>
        ))}
      </div>
    )}

    {signal.sources.length > 0 && (
      <details class="mt-3 group">
        <summary class="text-xs text-[var(--tp-muted)] cursor-pointer hover:text-[var(--tp-fg)] list-none inline-flex items-center gap-1 select-none">
          <span class="transition-transform group-open:rotate-90 inline-block">▸</span>
          来源 · {signal.sources.length}
        </summary>
        <ul class="mt-2 space-y-1 text-xs pl-4">
          {signal.sources.map((s) => (
            <li>
              <a href={s} target="_blank" rel="noopener" class="break-all hover:underline text-[var(--tp-muted)] hover:text-brand-600">
                {s}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>
</article>
