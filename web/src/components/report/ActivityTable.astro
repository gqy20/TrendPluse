---
/**
 * 生态活跃度表:本期有提交的仓库榜单(排名 + 仓库 + 贡献者 + 提交数)。
 * 默认展示前 limit 行,其余折叠,点击展开——与 SignalTable 的渐进披露一致。
 * 设计语言:tp-row 发丝线行 / tp-mono 仓库 / tp-num 大数字。
 */
import { repoUrl } from '../../lib/format';
import type { RepoActivity } from '../../content.config';

interface Props {
  repos?: RepoActivity[];
  limit?: number;
}
const { repos = [], limit = 10 } = Astro.props;
const sorted = [...repos].sort((a, b) => (b.commits ?? 0) - (a.commits ?? 0));
const rest = sorted.slice(limit);
---

{sorted.length > 0 && (
  <div class="activity-table border-t border-hairline" data-activity-table>
    {sorted.map((r, i) => {
      const contributors = r.top_contributors ?? [];
      const shown = contributors.slice(0, 3);
      const more = contributors.length - shown.length;
      return (
        <div class="tp-row border-b border-hairline px-1 -mx-1" data-activity-row hidden={i >= limit}>
          <div class="grid md:grid-cols-[40px_minmax(0,1fr)_110px] gap-x-5 gap-y-1 items-baseline">
            <span class="tp-num text-[18px] text-ink-3">{String(i + 1).padStart(2, '0')}</span>
            <div class="min-w-0">
              <a href={repoUrl(r.repo)} target="_blank" rel="noopener" class="tp-mono text-ink hover:text-accent transition-colors truncate">{r.repo}</a>
              {shown.length > 0 && (
                <p class="tp-mono text-[12px] text-ink-3 mt-1 truncate">
                  {shown.join(' · ')}{more > 0 && ` +${more}`}
                </p>
              )}
            </div>
            <span class="tp-num text-[22px] text-ink md:text-right">{r.commits ?? '—'}</span>
          </div>
        </div>
      );
    })}
    {rest.length > 0 && (
      <button type="button" data-activity-more class="tp-link block mt-4 py-2 cursor-pointer" aria-expanded="false">
        展开其余 {rest.length} 个仓库 ↓
      </button>
    )}
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-activity-table]').forEach(table => {
    const rows = [...table.querySelectorAll<HTMLElement>('[data-activity-row]')];
    const more = table.querySelector<HTMLButtonElement>('[data-activity-more]');
    if (!more || rows.length === 0) return;
    more.addEventListener('click', () => {
      rows.forEach(row => { row.hidden = false; });
      more.hidden = true;
    });
  });
</script>
