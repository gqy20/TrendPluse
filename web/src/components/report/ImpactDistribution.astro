---
import type { DailyReport } from '../../content.config';

/**
 * 影响分布图：统计当天所有信号（工程/研究/commit/release）的 impact_score，
 * 按 1-5★ 分桶画柱状图，高影响（≥4★）用 status-high 色突出。
 */
interface Props {
  report: DailyReport;
}
const { report } = Astro.props;

const all = [
  ...report.engineering_signals,
  ...report.research_signals,
  ...report.commit_signals,
  ...report.release_signals,
];

const levels = [5, 4, 3, 2, 1]; // 高→低 展示
const dist = levels.map((lvl) => ({
  level: lvl,
  count: all.filter((s) => Math.round(s.impact_score || 0) === lvl).length,
}));
const max = Math.max(1, ...dist.map((d) => d.count));
const total = all.length;
const highCount = dist.filter((d) => d.level >= 4).reduce((a, b) => a + b.count, 0);
const tier = (lvl: number): 'high' | 'medium' | 'low' =>
  lvl >= 4 ? 'high' : lvl === 3 ? 'medium' : 'low';
---

{total > 0 && (
  <section class="space-y-3">
    <h2 class="text-xl font-bold">📊 影响分布</h2>
    <div class="p-4 rounded-lg border border-[var(--tp-border)] bg-[var(--tp-surface)]">
      <div class="flex items-end justify-between gap-3 h-32">
        {dist.map((d) => (
          <div class="flex-1 h-full flex flex-col items-center justify-end gap-1.5">
            <span class="text-xs font-bold tabular-nums text-[var(--tp-fg)]">{d.count}</span>
            <div
              class="w-full max-w-[3rem] rounded-t-md transition-all"
              style={`height:${Math.max(4, (d.count / max) * 100)}%;background:var(--color-status-${tier(d.level)})`}
              title={`${d.level}★: ${d.count} 条`}
            ></div>
            <span class="text-xs text-[var(--tp-muted)]">{d.level}★</span>
          </div>
        ))}
      </div>
      <div class="mt-3 pt-3 border-t border-[var(--tp-border)] flex items-center justify-between text-xs">
        <span class="text-[var(--tp-muted)]">共 {total} 条信号</span>
        <span class="text-status-high font-medium" style="color:var(--color-status-high)">高影响 ≥4★ · {highCount} 条</span>
      </div>
    </div>
  </section>
)}
