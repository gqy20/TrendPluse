---
/**
 * 全部信号表(设计稿规格 + 筛选增强):
 * - 表头中文小灰字;编号 mono;影响 3 小柱;置信度 10 方点
 * - filterable:类型/影响筛选 chips(纯前端,数据来自行 data 属性)
 */
import type { Signal } from '../../content.config';
import { signalLabel } from '../../lib/format';

interface Props {
  signals: Signal[];
  start?: number;
  time?: string;
  limit?: number;
  clickable?: boolean;
  filterable?: boolean;
}
const { signals, start = 1, time, limit = 12, clickable = false, filterable = false } = Astro.props;

const all = limit > 0 ? signals.slice(0, limit) : signals;
const hidden = signals.length - all.length;

/** 来源 URL → 短格式 */
function shortSource(url: string): string {
  const m = url.match(/github\.com\/([^/]+\/[^/]+)(?:\/(pull|releases\/tag|commit|issues)\/([^/]+))?/);
  if (!m) return url.replace(/^https?:\/\//, '').slice(0, 28);
  const [, repo, kind, id] = m;
  if (kind === 'pull' || kind === 'issues') return `${repo}#${id}`;
  if (kind === 'releases/tag') return `${repo} ${id}`;
  if (kind === 'commit') return `${repo}@${id.slice(0, 7)}`;
  return repo;
}

/** 影响分 → 柱数与颜色档 */
function impactBars(score?: number | null): { n: number; color: string } {
  const s = score ?? 0;
  if (s >= 4) return { n: 3, color: '#cc3b33' };
  if (s >= 3) return { n: 2, color: '#bf732e' };
  return { n: 1, color: '#636b78' };
}

// 筛选 chips:仅列出实际出现的类型
const types = [...new Set(all.map((s) => s.type).filter(Boolean))];
---

<div data-signal-table>
  {
    filterable && types.length > 1 && (
      <div class="flex flex-wrap items-center gap-2 mb-5" data-signal-filters>
        <button type="button" data-f="type:all" class="sf-chip sf-chip--on">
          全部
        </button>
        {types.map((t) => (
          <button type="button" data-f={`type:${t}`} class="sf-chip">
            {signalLabel(t)}
          </button>
        ))}
        <span class="w-px h-4 bg-hairline mx-1.5" />
        <button type="button" data-f="impact:all" class="sf-chip sf-chip--on">
          全部影响
        </button>
        <button type="button" data-f="impact:high" class="sf-chip">
          高影响
        </button>
        <span class="sf-count tp-mono text-ink-3 ml-2" data-signal-count>
          {all.length} 条
        </span>
      </div>
    )
  }

  <table class="tp-table">
    <thead>
      <tr>
        <th class="w-[54px] font-sans normal-case tracking-normal text-[13px] opacity-62">#</th>
        <th class="font-sans normal-case tracking-normal text-[13px] opacity-62">标题</th>
        <th class="w-[110px] hidden md:table-cell font-sans normal-case tracking-normal text-[13px] opacity-62">分类</th>
        <th class="w-[190px] hidden lg:table-cell font-sans normal-case tracking-normal text-[13px] opacity-62">来源</th>
        <th class="w-[110px] hidden md:table-cell font-sans normal-case tracking-normal text-[13px] opacity-62">时间</th>
        <th class="w-[120px] font-sans normal-case tracking-normal text-[13px] opacity-62">影响</th>
        <th class="w-[96px] hidden lg:table-cell font-sans normal-case tracking-normal text-[13px] opacity-62">置信度</th>
      </tr>
    </thead>
    <tbody>
      {
        all.map((s, i) => {
          const bars = impactBars(s.impact_score);
          return (
            <tr
              class:list={[clickable && 'cursor-pointer']}
              data-signal-detail={clickable ? s.id : undefined}
              data-type={s.type}
              data-impact={(s.impact_score ?? 0) >= 4 ? 'high' : 'all'}
            >
              <td class="tp-mono text-ink-3 text-[13px]">{String(start + i).padStart(2, '0')}</td>
              <td>
                <div class="text-[13px] leading-[1.45]">{s.title}</div>
                {s.related_repos[0] && <span class="tp-mono text-ink-3 text-[12px]">{s.related_repos[0]}</span>}
              </td>
              <td class="hidden md:table-cell text-[13px] text-[#636b78]">{signalLabel(s.type)}</td>
              <td class="hidden lg:table-cell">
                {s.sources[0] && (
                  <a href={s.sources[0]} target="_blank" rel="noopener" class="tp-mono text-[12px] text-[#636b78] hover:text-accent transition-colors whitespace-nowrap">
                    {shortSource(s.sources[0])}
                  </a>
                )}
              </td>
              <td class="tp-mono text-[12px] text-[#636b78] hidden md:table-cell">{time ?? '—'}</td>
              <td>
                <span class="inline-flex gap-[4px] items-center">
                  {[1, 2, 3].map((k) => (
                    <span class="inline-block h-[10px] w-[6px] rounded-[1px]" style={`background:${k <= bars.n ? bars.color : '#f0ede5'}`} />
                  ))}
                </span>
              </td>
              <td class="hidden lg:table-cell">
                <span class="inline-flex gap-[2px] items-center">
                  {Array.from({ length: 10 }).map(() => (
                    <span class="inline-block size-[5px] rounded-[1px] bg-[#f0ede5]" />
                  ))}
                </span>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  {
    hidden > 0 && (
      <p class="tp-mono text-ink-3 mt-4">
        已展示前 {all.length} 条 · 共 {signals.length} 条
      </p>
    )
  }
</div>

<style>
  .sf-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 5px 12px;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    color: var(--color-ink-2);
    background: transparent;
    cursor: pointer;
    transition: all 140ms ease-out;
  }
  .sf-chip:hover {
    border-color: var(--color-ink-3);
    color: var(--color-ink);
  }
  .sf-chip--on {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
</style>

<script>
  // 筛选岛屿:类型 + 影响,同一 [data-signal-table] 独立
  document.querySelectorAll('[data-signal-table]').forEach((root) => {
    const bar = root.querySelector('[data-signal-filters]');
    if (!bar) return;
    const rows = Array.from(root.querySelectorAll('tbody tr'));
    const countEl = root.querySelector('[data-signal-count]');
    const state = { type: 'all', impact: 'all' };

    const apply = () => {
      let visible = 0;
      rows.forEach((r) => {
        const el = r as HTMLElement;
        const ok =
          (state.type === 'all' || el.dataset.type === state.type) &&
          (state.impact === 'all' || el.dataset.impact === state.impact);
        el.classList.toggle('hidden', !ok);
        if (ok) visible++;
      });
      if (countEl) countEl.textContent = `${visible} 条`;
    };

    bar.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('button[data-f]');
      if (!btn) return;
      const [kind, val] = btn.dataset.f!.split(':') as ['type' | 'impact', string];
      state[kind] = val;
      bar.querySelectorAll<HTMLButtonElement>(`button[data-f^="${kind}:"]`).forEach((b) => {
        const on = b === btn;
        b.classList.toggle('sf-chip--on', on);
      });
      apply();
    });
  });
</script>
