---
import type { ReleaseInfo } from '../../content.config';
import { repoUrl } from '../../lib/format';

interface Props {
  releases: { releases?: ReleaseInfo[] } | ReleaseInfo[] | null | undefined;
}

// 与后端 RELEASE_CHANGE_TYPE_EMOJIS（feishu_formatter）保持一致
const CHANGE_TYPE_BADGES: Record<string, { emoji: string; label: string }> = {
  feature: { emoji: '🆕', label: '新功能' },
  fix: { emoji: '🔧', label: '修复' },
  improvement: { emoji: '✨', label: '改进' },
  breaking: { emoji: '💥', label: '不兼容' },
  other: { emoji: '📦', label: '其他' },
};

const { releases } = Astro.props;
const list: ReleaseInfo[] = Array.isArray(releases) ? releases : releases?.releases || [];
---

{list.length > 0 && (
  <section>
    <h2 class="text-xl font-bold mb-3">🎯 发布动态</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      {list.map((r) => {
        const badge = r.ai_summary?.change_type
          ? CHANGE_TYPE_BADGES[r.ai_summary.change_type]
          : undefined;
        return (
          <div class="p-3 rounded-lg border border-[var(--tp-border)] bg-[var(--tp-surface)]">
            <div class="flex items-center gap-2 flex-wrap">
              {r.repo && (
                <a href={repoUrl(r.repo)} target="_blank" rel="noopener" class="font-mono text-sm font-medium hover:underline">
                  {r.repo}
                </a>
              )}
              {r.version && (
                <span class="text-xs px-1.5 py-0.5 rounded bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-200 font-mono">
                  {r.version}
                </span>
              )}
              {badge && (
                <span
                  class={`text-xs px-1.5 py-0.5 rounded font-medium ${
                    badge.label === '不兼容'
                      ? 'bg-red-50 text-red-700 dark:bg-red-900/40 dark:text-red-200'
                      : 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-200'
                  }`}
                >
                  {badge.emoji} {badge.label}
                </span>
              )}
              {r.ai_summary?.impact_level != null && r.ai_summary.impact_level >= 4 && (
                <span class="text-xs px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 dark:bg-amber-900/40 dark:text-amber-200 font-medium">
                  影响 L{r.ai_summary.impact_level}
                </span>
              )}
              {r.date && <span class="text-xs text-[var(--tp-muted)]">{r.date}</span>}
            </div>
            {(r.ai_summary?.summary_cn || r.summary) && (
              <p class="mt-1.5 text-sm text-[var(--tp-muted)] leading-relaxed">
                {r.ai_summary?.summary_cn || r.summary}
              </p>
            )}
            {r.ai_summary?.key_changes && r.ai_summary.key_changes.length > 0 && (
              <ul class="mt-1.5 space-y-0.5">
                {r.ai_summary.key_changes.slice(0, 3).map((change) => (
                  <li class="text-xs text-[var(--tp-muted)] leading-relaxed flex gap-1.5">
                    <span class="text-[var(--tp-border)] select-none">└</span>
                    <span>{change}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        );
      })}
    </div>
  </section>
)}
