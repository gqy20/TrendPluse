---
  /**
   * 信号来源分布条(首屏仪表化):
   * 主分布按 signal_class(工程/研究/Commit/Release,与全部信号表格的筛选按钮联动),
   * 类型分布(type)降为紧凑图例——语义概览保留,但不再承担筛选。
   */
import type { Signal } from '../../content.config';
import { signalLabel, signalClass } from '../../lib/format';

interface ClassifiedSignal extends Signal { signal_class?: string }
interface Props {
  signals: ClassifiedSignal[];
  period?: string;
  targetId?: string;
  heading?: string;
  panel?: boolean;
  sourceDescription?: string;
}
const { signals, period, targetId, heading, panel = false, sourceDescription = '本期日报的工程、研究、提交与发布信号' } = Astro.props;

const classCounts = new Map<string, number>();
const typeCounts = new Map<string, number>();
for (const s of signals) {
  const cls = s.signal_class ?? 'other';
  classCounts.set(cls, (classCounts.get(cls) ?? 0) + 1);
  typeCounts.set(s.type, (typeCounts.get(s.type) ?? 0) + 1);
}
const classParts = [...classCounts.entries()].sort((a, b) => b[1] - a[1]);
const typeParts = [...typeCounts.entries()].sort((a, b) => b[1] - a[1]);
const total = signals.length || 1;

const clsLabel = (cls: string) => signalClass(cls)?.label ?? '其他';
const clsColor = (cls: string) => signalClass(cls)?.color ?? 'var(--color-ink-3)';
---

{(classParts.length > 0 || panel) && (
  <figure data-signal-distribution data-target={targetId} class:list={[panel && 'distribution-panel']}>
    {heading && <h2 class="text-[14px] font-medium mb-3">{heading}</h2>}
    {panel ? <div class="distribution-rows">
      {classParts.map(([cls, count]) => <button type="button" data-signal-type={cls} class="distribution-row" aria-label={`${clsLabel(cls)}：${count} 条，占 ${Math.round(count / total * 1000) / 10}%，筛选该来源`}>
        <span>{clsLabel(cls)}</span>
        <span class="distribution-track"><span style={`width:${count / total * 100}%;background:${clsColor(cls)}`} /></span>
        <strong>{count}</strong><small>{Math.round(count / total * 1000) / 10}%</small>
      </button>)}
      {classParts.length === 0 && <p class="text-[13px] text-ink-2">本期没有可分类的信号。</p>}
    </div> : <>
    <div class="flex h-[8px] rounded-[2px] overflow-hidden gap-[2px]">
      {classParts.map(([cls, n]) => (
        <button type="button" data-signal-type={cls}
          class="block h-full rounded-[2px] cursor-pointer"
          style={`width:${(n / total) * 100}%;background:${clsColor(cls)}`}
          aria-label={`${clsLabel(cls)}：${n} 条，占 ${Math.round(n / total * 1000) / 10}%${targetId ? '，筛选该来源' : ''}`}
          title={`${clsLabel(cls)} ${n} 条 · ${Math.round(n / total * 1000) / 10}%`}
        />
      ))}
    </div>
    <div class="flex flex-wrap gap-x-5 gap-y-1.5 mt-3">
      {classParts.map(([cls, n]) => (
        <button type="button" data-signal-type={cls} class="flex items-center gap-1.5 tp-mono text-ink-2 py-1 cursor-pointer" title={`${clsLabel(cls)} ${n} 条 · ${Math.round(n / total * 1000) / 10}%`}>
          <span class="inline-block size-[7px] rounded-[2px]" style={`background:${clsColor(cls)}`} />
          {clsLabel(cls)} <span class="text-ink-3">{n}</span>
        </button>
      ))}
    </div>
    </>}
    {typeParts.length > 0 && <p class="type-legend">
      <span class="type-legend-title">类型</span>
      {typeParts.map(([t, n]) => <span>{signalLabel(t)} {n}</span>)}
    </p>}
    {period && <figcaption class="text-[12px] leading-relaxed text-ink-2 mt-3">{period} · {panel ? `来源：本期 ${signals.length} 条信号明细，每条计一次。点击来源可筛选。` : `按本页 ${signals.length} 条信号明细分组，每条计一次。来源：${sourceDescription}；图例可直接筛选，悬停查看数量与占比。`}</figcaption>}
  </figure>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-signal-distribution]').forEach(chart => {
    chart.addEventListener('click', event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-signal-type]');
      const target = chart.dataset.target ? document.getElementById(chart.dataset.target) : chart.closest('section');
      const tag = [...target?.querySelectorAll<HTMLButtonElement>('[data-type-filter]') ?? []].find(item => item.dataset.typeFilter === button?.dataset.signalType);
      if (!button || !tag) return;
      tag.click();
      target?.scrollIntoView({ behavior:'instant', block:'start' });
      tag.focus({ preventScroll:true });
    });
  });
</script>

<style>
  .distribution-panel { padding-top:4px; }
  .distribution-panel h2 { font-size:16px; }
  .distribution-rows { display:flex; flex-direction:column; gap:8px; }
  .distribution-row { display:grid; grid-template-columns:60px minmax(0,1fr) 28px 36px; align-items:center; gap:10px; min-height:28px; width:100%; text-align:left; font-size:12px; cursor:pointer; }
  .distribution-row:hover { color:var(--color-accent); }
  .distribution-track { display:block; height:6px; background:var(--color-paper-deep); border-radius:2px; }
  .distribution-track > span { display:block; height:100%; border-radius:2px; }
  strong { font-weight:500; text-align:right; font-variant-numeric:tabular-nums; }
  small { font-size:11px; text-align:right; color:var(--color-ink-2); }
  .type-legend { display:flex; flex-wrap:wrap; gap-x-4 gap-y-1; margin-top:12px; font-family:var(--font-mono); font-size:11px; color:var(--color-ink-2); }
  .type-legend-title { color:var(--color-ink-3); letter-spacing:.08em; text-transform:uppercase; }
</style>
