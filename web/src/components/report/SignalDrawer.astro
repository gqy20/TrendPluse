---
/**
 * 信号详情抽屉 + 证据链(设计稿 07 · Signal Detail / 22 · Evidence Graph)。
 * 数据来源:页面内嵌 <script type="application/json" id="tp-signals-data">,
 * 触发:任意 [data-signal-detail="<id>"] 元素。
 * 证据链四层:判断 → 原始信号 → 原始变化(PR/Release/Commit/Issue)→ 仓库。
 * 渐进增强:无 JS 时 sources 链接仍然可用。
 */
---

<dialog id="tp-drawer" aria-label="信号详情" class="signal-dialog">
  <div id="tp-drawer-content"></div>
</dialog>
<style>
  .signal-dialog { position:fixed; inset:0 0 0 auto; margin:0; width:min(100vw,560px); height:100dvh; max-width:100vw; max-height:100dvh; border:0; padding:0; background:var(--color-paper); color:var(--color-ink); overflow-y:auto; overscroll-behavior:contain; overflow-wrap:anywhere; }
  .signal-dialog::backdrop { background:rgb(15 18 23 / .28); }
  .signal-dialog :global(button) { cursor:pointer; min-height:40px; }
  .signal-dialog :global(:focus-visible) { outline:2px solid var(--color-accent); outline-offset:3px; }
</style>

<script>
  import { renderRating } from '../../lib/ratings';
  import { signalClass } from '../../lib/format';
  interface Sig {
    id: string;
    title: string;
    type: string;
    category: string;
    signal_class?: string;
    impact_score?: number | null;
    why_it_matters: string;
    sources: string[];
    related_repos: string[];
    source_signal_ids: string[];
  }

  const TYPE_LABEL: Record<string, string> = {
    capability: '新能力',
    abstraction: '抽象层',
    workflow: '工作流',
    eval: '评估',
    safety: '安全',
    performance: '性能',
    commit: '提交',
    release: '批量发版',
  };

  /** 从 URL 推断原始变化类型(设计稿:PR 蓝 / ISSUE 橙 / RELEASE 红 / COMMIT 灰) */
  function sourceKind(url: string): { label: string; color: string } {
    if (/\/pull\//.test(url)) return { label: 'PR', color: 'text-accent' };
    if (/\/issues?\//.test(url)) return { label: 'ISSUE', color: 'text-[#b08a3e]' };
    if (/\/releases?\//.test(url)) return { label: 'RELEASE', color: 'text-impact' };
    if (/\/commit/.test(url)) return { label: 'COMMIT', color: 'text-ink-2' };
    return { label: 'SOURCE', color: 'text-ink-3' };
  }

  /** URL → 短标签:owner/repo @ 短SHA / owner/repo #编号 / owner/repo tag */
  function shortLabel(url: string): string {
    const path = url.replace('https://github.com/', '').split('?')[0].replace(/\/$/, '');
    const pr = path.match(/^([\w.-]+\/[\w.-]+)\/pull\/(\d+)$/);
    if (pr) return `${pr[1]} #${pr[2]}`;
    const issue = path.match(/^([\w.-]+\/[\w.-]+)\/issues\/(\d+)$/);
    if (issue) return `${issue[1]} #${issue[2]}`;
    const release = path.match(/^([\w.-]+\/[\w.-]+)\/releases\/(?:tag\/)?(.+)$/);
    if (release) return `${release[1]} ${release[2]}`;
    const commit = path.match(/^([\w.-]+\/[\w.-]+)\/commit\/([0-9a-f]{7})/);
    if (commit) return `${commit[1]} @ ${commit[2]}`;
    return path;
  }

  const drawer = document.getElementById('tp-drawer') as HTMLDialogElement;
  let trigger: HTMLElement | null = null;
  let originalOverflow = '';
  const content = document.getElementById('tp-drawer-content')!;

  function signalsMap(): Record<string, Sig> {
    const el = document.getElementById('tp-signals-data');
    if (!el) return {};
    try {
      return Object.fromEntries((JSON.parse(el.textContent || '[]') as Sig[]).map((s) => [s.id, s]));
    } catch {
      return {};
    }
  }

  function esc(s: string): string {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function render(s: Sig, map: Record<string, Sig>) {
    const sources = s.sources.filter(u => /^https?:\/\//i.test(u)).map((u) => {
      const k = sourceKind(u);
      return `<a href="${esc(u)}" target="_blank" rel="noopener" title="${esc(u)}" class="tp-row border-b border-hairline flex items-baseline gap-4">
        <span class="tp-mono ${k.color} w-15 shrink-0">${k.label}</span>
        <span class="tp-mono text-ink-2 truncate">${esc(shortLabel(u))}</span>
      </a>`;
    });

    const children = s.source_signal_ids
      .map((id) => map[id])
      .filter(Boolean)
      .map(
        (c) => `<button data-signal-detail="${esc(c.id)}" class="tp-row border-b border-hairline w-full text-left">
          <span class="tp-meta text-ink line-clamp-2">${esc(c.title)}</span>
        </button>`
      );

    const repos = s.related_repos
      .map(
        (r) => `<a href="https://github.com/${esc(r)}" target="_blank" rel="noopener" class="tp-mono border border-hairline px-2.5 py-1 text-ink-2 hover:text-accent hover:border-accent transition-colors">${esc(r)}</a>`
      )
      .join('');

    const evidence = children.length
      ? `<p class="tp-meta text-ink-3 mt-6 mb-1">此判断聚合了 ${children.length} 条原始信号:</p>${children.join('')}`
      : '';

    const classInfo = signalClass(s.signal_class);
    const classLabel = classInfo
      ? `<span style="color:${classInfo.color}">${classInfo.label}</span>`
      : s.category === 'research' ? '研究' : '工程';

    content.innerHTML = `
      <header class="sticky top-0 bg-paper px-7 py-4 flex items-center justify-between gap-4">
        <span class="tp-tag">${TYPE_LABEL[s.type] ?? '信号'} · ${classLabel}</span>
        <button id="tp-drawer-close" aria-label="关闭" class="tp-mono text-ink-3 hover:text-ink transition-colors">esc ✕</button>
      </header>
      <div class="px-7 py-6">
        <!-- 第一层:判断 -->
        <h2 class="tp-h2 text-[28px]">${esc(s.title)}</h2>
        <p class="tp-mono text-ink-2 mt-3">影响 ${renderRating(s.impact_score)}</p>
        <p class="tp-body text-ink-2 mt-5">${esc(s.why_it_matters)}</p>

        <!-- 第二层:原始信号 -->
        ${evidence}

        <!-- 第三层:原始变化 -->
        <h3 class="tp-mono text-ink mt-8 mb-2">原始变化 · ${sources.length}</h3>
        ${sources.join('') || '<p class="tp-meta text-ink-3">无来源链接。</p>'}

        <!-- 第四层:仓库 -->
        ${repos ? `<h3 class="tp-mono text-ink mt-8 mb-3">涉及仓库</h3><div class="flex flex-wrap gap-2">${repos}</div>` : ''}
      </div>`;

    document.getElementById('tp-drawer-close')?.addEventListener('click', close);
  }

  function open(id: string, opener: HTMLElement) {
    const map = signalsMap();
    const s = map[id];
    if (!s) return;
    if (!drawer.open) {
      trigger = opener;
      originalOverflow = document.body.style.overflow;
    }
    render(s, map);
    if (!drawer.open) drawer.showModal();
    document.body.style.overflow = 'hidden';
    drawer.scrollTop = 0;
    document.getElementById('tp-drawer-close')?.focus({ preventScroll:true });
  }

  function close() { drawer.close(); }

  drawer.addEventListener('close', () => {
    document.body.style.overflow = originalOverflow;
    trigger?.focus({ preventScroll:true });
  });
  drawer.addEventListener('click', event => {
    const rect = drawer.getBoundingClientRect();
    if (event.target === drawer && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) close();
  });
  document.addEventListener('click', event => {
    const target = (event.target as HTMLElement).closest<HTMLElement>('[data-signal-detail]');
    if (!target || (event.target as HTMLElement).closest('a')) return;
    event.preventDefault();
    const opener = target instanceof HTMLButtonElement ? target : target.querySelector<HTMLButtonElement>('button[data-signal-detail]') ?? target;
    open(target.dataset.signalDetail!, opener);
  });
</script>
