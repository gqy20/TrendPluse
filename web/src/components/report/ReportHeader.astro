---
interface MetaItem {
  label: string;
  value: string | number;
}

interface Props {
  title: string;
  summary?: string;
  subtitle?: string;
  meta?: MetaItem[];
}
const { title, summary, subtitle, meta = [] } = Astro.props;
---

<header class="space-y-4 pb-6 border-b border-[var(--tp-border)]">
  <div>
    {subtitle && (
      <div data-reveal class="text-xs uppercase tracking-wider text-[var(--tp-muted)] mb-1">{subtitle}</div>
    )}
    <h1 data-reveal class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h1>
  </div>
  {summary && (
    <p data-reveal class="text-base leading-relaxed text-[var(--tp-fg)] opacity-85">{summary}</p>
  )}
  {meta.length > 0 && (
    <div data-reveal class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm pt-4 border-t border-[var(--tp-border)]">
      {meta.map((m, i) => (
        <span class="inline-flex items-center gap-1">
          {i > 0 && <span class="text-[var(--tp-border)]">·</span>}
          <span class="text-[var(--tp-muted)]">{m.label}</span>
          <span
            class="font-semibold tabular-nums text-brand-600 dark:text-brand-400"
            data-count-up={typeof m.value === 'number' ? m.value : undefined}
          >{m.value}</span>
        </span>
      ))}
    </div>
  )}
</header>
