---
interface MetaItem {
  label: string;
  value: string | number;
}

interface Props {
  title: string;
  summary?: string;
  subtitle?: string;
  meta?: MetaItem[];
}
const { title, summary, subtitle, meta = [] } = Astro.props;
---

<header class="space-y-4 pb-6 border-b border-[var(--tp-border)]">
  <div>
    {subtitle && (
      <div class="text-xs uppercase tracking-wider text-[var(--tp-muted)] mb-1">{subtitle}</div>
    )}
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{title}</h1>
  </div>
  {summary && (
    <p class="text-base leading-relaxed text-[var(--tp-fg)] opacity-85">{summary}</p>
  )}
  {meta.length > 0 && (
    <dl class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {meta.map((m) => (
        <div class="flex items-center gap-1.5">
          <dt class="text-[var(--tp-muted)]">{m.label}:</dt>
          <dd class="font-semibold tabular-nums">{m.value}</dd>
        </div>
      ))}
    </dl>
  )}
</header>
