# TrendPulse 环境变量配置

# ===========================================
# 必需配置
# ===========================================

# Anthropic/智谱 AI API Key
# 支持两种环境变量名：ANTHROPIC_API_KEY 或 ANTHROPIC_AUTH_KEY
# 获取方式: https://open.bigmodel.cn/usercenter/apikeys
ANTHROPIC_API_KEY=your-api-key-here
# 备选（如果上面不存在）：
# ANTHROPIC_AUTH_KEY=your-api-key-here

# ===========================================
# 可选配置
# ===========================================

# GitHub Token (用于获取 PR 详情)
# 获取方式: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token-here

# API Base URL
# 智谱 AI: https://open.bigmodel.cn/api/anthropic
# Anthropic: https://api.anthropic.com
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# 模型名称
ANTHROPIC_MODEL=glm-4.7

# ===========================================
# 高级配置
# ===========================================

# 最大候选事件数
MAX_CANDIDATES=20

# Open PR 筛选配置
# 是否包含 open PR（默认: false，只包含已合并的 PR）
ENABLE_OPEN_PRS=false
# open PR 最小改动文件数阈值（默认: 3，范围: 1-50）
OPEN_PR_MIN_CHANGED_FILES=3

# 每日 Token 预算（软限制：超出仅告警不熔断，默认: 50000000）
DAILY_TOKEN_BUDGET=100000

# 说明：日报 JSON 中 total_cost_usd / daily_llm_usage.total_cost_usd 均为
# claude-agent-sdk 按 Claude 官方价目折算的「名义估算值」，经第三方网关
# 调用时不等于真实支出。成本核算请以 token 数为准。

# 监控的仓库列表 (逗号分隔)
GITHUB_REPOS=anthropics/skills,anthropics/claude-quickstarts,anthropics/claude-agent-sdk-python

# 并行采集配置
# 最大线程数 (默认: 8, 范围: 1-32)
# 注意：此值直接决定候选采集（80 仓库 PR 事件）的并行度——
# 实测中该阶段占总耗时一半以上。如需提速可逐步上调（如 16），
# 出现 403/429 限流告警时回调。
MAX_PARALLEL_WORKERS=8

# ===========================================
# Commit 分析 Agent 配置
# ===========================================

# Commit 分析 Agent 单批次最大预算（美元，默认: 10.0，范围: 0.1-200）
# 注意：经第三方网关（非 Anthropic 官方）调用时，claude-agent-sdk 会按
# Claude 官方价目表估算成本，预算过低会触发 "Reached maximum budget"
# 并导致整批 commit 信号丢失。仓库数量多时建议 >= 20。
COMMIT_AGENT_MAX_BUDGET_USD=20.0

# ===========================================
# 日报总结 Agent 配置
# ===========================================

# 是否启用基于全量历史日报的日报总结增强（默认: true）
ENABLE_DAILY_SUMMARY_AGENT=true

# 日报总结 Agent 模型（为空则跟随默认模型）
# DAILY_SUMMARY_AGENT_MODEL=sonnet

# 日报总结 Agent 最大轮数
DAILY_SUMMARY_AGENT_MAX_TURNS=20

# 日报总结 Agent 最大预算（美元）
DAILY_SUMMARY_AGENT_MAX_BUDGET_USD=5.0

# 日报总结 Agent 结构化校验失败时的最大重试次数
DAILY_SUMMARY_AGENT_RETRY_MAX_ATTEMPTS=2

# 日报总结 Agent 重试等待时间（秒）
DAILY_SUMMARY_AGENT_RETRY_WAIT_SECONDS=0.0
