# TrendPulse 环境变量配置

# ===========================================
# 必需配置
# ===========================================

# Anthropic/智谱 AI API Key
# 支持两种环境变量名：ANTHROPIC_API_KEY 或 ANTHROPIC_AUTH_KEY
# 获取方式: https://open.bigmodel.cn/usercenter/apikeys
ANTHROPIC_API_KEY=your-api-key-here
# 备选（如果上面不存在）：
# ANTHROPIC_AUTH_KEY=your-api-key-here

# ===========================================
# 可选配置
# ===========================================

# GitHub Token (用于获取 PR 详情)
# 获取方式: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token-here

# API Base URL
# 智谱 AI: https://open.bigmodel.cn/api/anthropic
# Anthropic: https://api.anthropic.com
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# 模型名称
ANTHROPIC_MODEL=glm-4.7

# ===========================================
# 高级配置
# ===========================================

# 最大候选事件数
MAX_CANDIDATES=20

# Open PR 筛选配置
# 是否包含 open PR（默认: false，只包含已合并的 PR）
ENABLE_OPEN_PRS=false
# open PR 最小改动文件数阈值（默认: 3，范围: 1-50）
OPEN_PR_MIN_CHANGED_FILES=3

# 每日 Token 预算
DAILY_TOKEN_BUDGET=100000

# 监控的仓库列表 (逗号分隔)
GITHUB_REPOS=anthropics/skills,anthropics/claude-quickstarts,anthropics/claude-agent-sdk-python

# 并行采集配置
# 最大线程数 (默认: 8, 范围: 1-32)
MAX_PARALLEL_WORKERS=8
